# ============ Kione Hardware API - Environment Variables ============
# Copy this file to .env and fill in your values.
#
#   Development: sqlite locally + sandbox M-Pesa + http://localhost:5173
#   Production:  managed PostgreSQL + live M-Pesa + your frontend domain
#
# Only the variables actually used by the app are listed here.

# ---------- Core (REQUIRED) ----------
# Dev:  sqlite:///./kione.db
# Prod: postgresql://user:password@host:5432/hardware_db  (Render gives you this URL)
DATABASE_URL=sqlite:///./kione.db

# Signs JWT tokens. MUST be a long random value in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated browser origins allowed to call the API (cookie auth needs the exact origin).
# Dev:  http://localhost:5173,http://127.0.0.1:5173
# Prod: https://your-frontend-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- App runtime ----------
# development | production
ENVIRONMENT=development

# Auth cookie is marked Secure only when true. Set true in production (HTTPS).
COOKIE_SECURE=false

# Optional: required to create an admin account via the API. Empty = anyone can.
ADMIN_REGISTRATION_KEY=

# ---------- M-Pesa (REQUIRED for payments; ignore if not using checkout) ----------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
# Dev:  https://sandbox.safaricom.co.ke
# Prod: https://api.safaricom.co.ke
MPESA_API_BASE_URL=https://sandbox.safaricom.co.ke

# ---------- Cloudinary (REQUIRED for product image uploads) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- SMTP (REQUIRED for password-reset / notification emails) ----------
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=